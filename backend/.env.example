NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://planinarenje:planinarenje@localhost:5432/planinarenje_mp

# samo za skriptu postavi-baze (treba superkorisnika)
SETUP_DATABASE_URL=postgres://postgres@localhost:5432/postgres

# barem 32 znaka
JWT_TAJNA=promijeni-me-nasumicnom-tajnom-od-barem-32-znaka
TRAJANJE_TOKENA=15m

ADMIN_EMAIL=admin@planinarenje.hr
ADMIN_LOZINKA=promijeni-me-jakom-lozinkom

# prijava Googleom radi tek kad se popune
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# DOPUSTENO_PODRIJETLO=http://localhost:3000
# GOOGLE_PREUSMJERENJE=http://localhost:3000/prijava/google

# slanje e-maila (npr. Gmail s lozinkom za aplikacije);
# bez ovoga se u razvoju poruka samo ispisuje u konzolu
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_KORISNIK=tvoj.mail@gmail.com
# SMTP_LOZINKA=lozinka-za-aplikacije
# SMTP_POSILJATELJ=Alpira <tvoj.mail@gmail.com>
